{
  "name": "Bill",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "amount": {
      "type": "number",
      "description": "Valor"
    },
    "type": {
      "type": "string",
      "enum": [
        "payable",
        "receivable"
      ],
      "description": "Tipo: a pagar ou a receber"
    },
    "category_id": {
      "type": "string",
      "description": "ID da categoria"
    },
    "account_id": {
      "type": "string",
      "description": "ID da conta para pagamento/recebimento"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento/recebimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da conta"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Conta recorrente"
    },
    "recurring_type": {
      "type": "string",
      "enum": [
        "monthly",
        "weekly",
        "yearly"
      ],
      "description": "Tipo de recorr\u00eancia"
    },
    "is_variable_amount": {
      "type": "boolean",
      "default": false,
      "description": "Recorr\u00eancia com valor vari\u00e1vel"
    },
    "variable_months_count": {
      "type": "number",
      "description": "Quantidade de meses para criar (se vari\u00e1vel)"
    },
    "variable_amounts": {
      "type": "string",
      "description": "JSON com valores vari\u00e1veis por m\u00eas"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "contact_phone": {
      "type": "string",
      "description": "Telefone para contato/cobran\u00e7a"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do contato"
    },
    "supplier_full_name": {
      "type": "string",
      "description": "Nome completo do fornecedor"
    },
    "supplier_cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ do fornecedor"
    },
    "supplier_payment_type": {
      "type": "string",
      "enum": [
        "pix",
        "bank"
      ],
      "description": "Tipo de pagamento (PIX ou Transfer\u00eancia)"
    },
    "supplier_pix_key": {
      "type": "string",
      "description": "Chave PIX do fornecedor"
    },
    "supplier_bank_name": {
      "type": "string",
      "description": "Nome do banco do fornecedor"
    },
    "supplier_bank_agency": {
      "type": "string",
      "description": "Ag\u00eancia banc\u00e1ria do fornecedor"
    },
    "supplier_bank_account": {
      "type": "string",
      "description": "Conta banc\u00e1ria do fornecedor"
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "Conta exclu\u00edda (soft delete)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da exclus\u00e3o"
    },
    "deleted_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que excluiu"
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "due_date"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}
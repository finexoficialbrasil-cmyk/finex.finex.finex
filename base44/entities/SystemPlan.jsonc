{
  "name": "SystemPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plano (Mensal, Semestral, etc)"
    },
    "plan_type": {
      "type": "string",
      "enum": [
        "monthly",
        "semester",
        "annual",
        "lifetime"
      ],
      "description": "Tipo do plano"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o do plano"
    },
    "duration_months": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o em meses (999 para vital\u00edcio)"
    },
    "discount_percent": {
      "type": "number",
      "default": 0,
      "description": "Porcentagem de desconto"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de funcionalidades (textos)"
    },
    "allowed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "P\u00e1ginas permitidas para este plano",
      "default": [
        "Dashboard",
        "Profile",
        "Plans"
      ]
    },
    "transaction_limit": {
      "type": "number",
      "description": "Limite de transa\u00e7\u00f5es por m\u00eas (0 = ilimitado)"
    },
    "account_limit": {
      "type": "number",
      "description": "Limite de contas (0 = ilimitado)"
    },
    "has_ai_consultant": {
      "type": "boolean",
      "default": false,
      "description": "Acesso ao consultor IA"
    },
    "has_reports": {
      "type": "boolean",
      "default": false,
      "description": "Acesso a relat\u00f3rios"
    },
    "has_goals": {
      "type": "boolean",
      "default": false,
      "description": "Acesso a metas financeiras"
    },
    "is_popular": {
      "type": "boolean",
      "default": false,
      "description": "Marcar como popular"
    },
    "is_highlight": {
      "type": "boolean",
      "default": false,
      "description": "Destacar plano"
    },
    "color_gradient": {
      "type": "string",
      "description": "Gradiente de cor"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Plano ativo"
    }
  },
  "required": [
    "name",
    "plan_type",
    "price",
    "duration_months"
  ]
}
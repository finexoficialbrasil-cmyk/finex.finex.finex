{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da transa\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da transa\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "category_id": {
      "type": "string",
      "description": "ID da categoria"
    },
    "account_id": {
      "type": "string",
      "description": "ID da conta"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da transa\u00e7\u00e3o"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false,
      "description": "Transa\u00e7\u00e3o recorrente"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled"
      ],
      "default": "completed",
      "description": "Status da transa\u00e7\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionais"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio dono da transa\u00e7\u00e3o (para agente)"
    },
    "deleted": {
      "type": "boolean",
      "default": false,
      "description": "Transa\u00e7\u00e3o exclu\u00edda (soft delete)"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da exclus\u00e3o"
    },
    "deleted_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que excluiu"
    },
    "edited": {
      "type": "boolean",
      "default": false,
      "description": "Transa\u00e7\u00e3o foi editada"
    },
    "last_edited_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da \u00faltima edi\u00e7\u00e3o"
    },
    "last_edited_by": {
      "type": "string",
      "description": "Email do usu\u00e1rio que editou"
    },
    "edit_history": {
      "type": "string",
      "description": "JSON com hist\u00f3rico de edi\u00e7\u00f5es"
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_email": "{{user.email}}"
        }
      ]
    }
  }
}
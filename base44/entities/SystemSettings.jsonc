{
  "name": "SystemSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Chave da configura\u00e7\u00e3o"
    },
    "value": {
      "type": "string",
      "description": "Valor da configura\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da configura\u00e7\u00e3o"
    },
    "category": {
      "type": "string",
      "enum": [
        "branding",
        "features",
        "security",
        "integrations",
        "notifications",
        "payments"
      ],
      "description": "Categoria da configura\u00e7\u00e3o"
    }
  },
  "required": [
    "key",
    "value"
  ],
  "rls": {
    "read": true,
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}
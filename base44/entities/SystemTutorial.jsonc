{
  "name": "SystemTutorial",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo do tutorial do sistema"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do tutorial"
    },
    "video_url": {
      "type": "string",
      "description": "URL do v\u00eddeo (YouTube, Vimeo, etc)"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL da miniatura"
    },
    "category": {
      "type": "string",
      "enum": [
        "financas",
        "investimentos",
        "configuracoes",
        "seguranca",
        "relatorios",
        "iniciante",
        "avancado",
        "integracao"
      ],
      "description": "Categoria do tutorial"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Tutorial ativo"
    },
    "views_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de visualiza\u00e7\u00f5es"
    }
  },
  "required": [
    "title",
    "video_url",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
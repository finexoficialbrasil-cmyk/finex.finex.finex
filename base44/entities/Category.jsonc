{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "color": {
      "type": "string",
      "description": "Cor da categoria"
    },
    "icon": {
      "type": "string",
      "description": "\u00cdcone da categoria"
    },
    "budget_limit": {
      "type": "number",
      "description": "Limite de or\u00e7amento mensal"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "created_by": "{{user.email}}"
    },
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}